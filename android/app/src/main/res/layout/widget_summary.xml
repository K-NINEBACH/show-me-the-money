<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 한 장. 앱(웹) 홈 맨 위와 같은 것만 담는다 — 제목 한 줄, 큰 숫자, 작은 한 줄.
  색은 웹 테마와 맞춘다(#161B2E 바탕, #F2E8D5 글자, 금색 제목).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="카드로 더 써도 되는 돈"
        android:textColor="#D8B06A"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#F2E8D5"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="26sp"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="앱을 한 번 열어 주세요"
        android:textColor="#9AA3B8"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
