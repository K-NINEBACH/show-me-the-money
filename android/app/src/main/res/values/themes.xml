<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      화면 전체를 WebView가 채우므로 시스템 액션바는 끈다.
      배경색은 웹의 배경(#161B2E)과 맞춰 둔다 — 다르면 앱을 켤 때
      웹이 그려지기 전 한 프레임이 다른 색으로 번쩍인다.
    -->
    <style name="Theme.Passbook" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#161B2E</item>
        <item name="android:statusBarColor">#161B2E</item>
        <item name="android:navigationBarColor">#161B2E</item>
    </style>
</resources>
